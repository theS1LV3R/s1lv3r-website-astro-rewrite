---
import { HIRE_ME_ENABLED, TAGLINE } from "@/constants";
import Layout from "@layouts/Layout.astro";
import HireMe from "@components/HireMe.astro";
import ContactLinks from "@components/ContactLinks.astro";
---

<style lang="scss">
  .indent {
    @media (width >= 48rem) {
      padding-right: 1.25rem;
      padding-left: 1.25rem;
    }
  }
</style>

<Layout>
  <div class="about">
    <p>
      {TAGLINE}
    </p>
    <p>
      I am highly interested in everything computers, servers, networking, and
      generally technical. I am a heavy advocate for privacy, open-source, and
      other similar technologies and ideologies, and have a strong hatred for
      GenAI.
    </p>
    <p>
      I am currently primarily working on and contributing to <a
        href="https://continuwuity.org/"
        target="_blank"
        rel="noopener noreferrer">Continuwuity</a
      >, an open-source <a
        href="https://matrix.org"
        target="_blank"
        rel="noopener noreferrer">Matrix</a
      > homeserver written in Rust.
    </p>
  </div>

  {HIRE_ME_ENABLED && <HireMe />}

  <ContactLinks />
</Layout>
