---
import { getCollection, render } from "astro:content";
import ToC from "@components/ToC.astro";
import Blogpost from "@layouts/Blogpost.astro";
import "./content.scss";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter(
    (post) => post.data.published,
  );

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const dateFormat = (_date: Date): string => {
  const els = _date.toISOString().split(/T|\.|:/);
  const date = els[0];
  const timestamp = els.splice(1, 2);
  return `${date} ${timestamp.join(":")} (UTC)`;
};
---

<style lang="scss">
  .metadata {
    h1 {
      margin-bottom: 0.5rem;
    }

    span {
      color: #a1a1a1;
    }

    p {
      margin-top: 0;
    }

    ul#socials-links {
      display: inline-flex;
      list-style: none;
      padding-left: 0;
      margin-left: 0;

      li {
        padding-left: 1rem;
        display: flex;

        &:first-child {
          padding-left: 0;
        }

        svg {
        }
      }
    }

    #desc {
      padding-top: 1rem;
    }
  }

  .separator {
    margin-top: 1rem;

    &:last-of-type {
      margin-top: 0;
      margin-bottom: 1rem;
    }
  }
</style>

<Blogpost post={post}>
  <div class="metadata">
    <h1>{post.data.title}</h1>
    <span title="Posted and updated date">
      Posted on: {dateFormat(post.data.pubDate)}
      {
        post.data.updatedDate && post.data.updatedDate > post.data.pubDate && (
          <>
            <br />
            Last updated: {dateFormat(post.data.updatedDate)}
          </>
        )
      }
    </span>
    {
      post.data.socials && (
        <>
          <br />
          <span title="Social links">
            Discuss on:
            <ul id="socials-links">
              {post.data.socials.map(({ site, url }) => (
                <li>
                  <a href={url} target="_blank" rel="noopener noreferrer">
                    {site}
                  </a>
                </li>
              ))}
            </ul>
          </span>
        </>
      )
    }
    {
      post.data.description && (
        <p id="desc" title="Post description">
          {post.data.description}
        </p>
      )
    }
    <ToC headings={headings} />
  </div>

  <hr class="separator" />
  <div id="content">
    <Content />
  </div>
  <hr class="separator end" />
</Blogpost>
