---
import { getCollection } from "astro:content";
import { getDescription } from "@/utils";
import Layout from "@layouts/Layout.astro";

const posts = (await getCollection("blog"))
  .filter((post) => post.data.published)
  .sort((a, b) => (a.data.pubDate > b.data.pubDate ? -1 : 1));

const dateToIso = (date: Date) => date.toISOString().split("T")[0];
---

<style lang="scss">
  ul {
    list-style-type: none;
    padding: 0;

    // @media (width >= 48rem) {
    //   padding-right: 1.25rem;
    //   padding-left: 1.25rem;
    // }

    & > p {
      margin-top: 0;
    }
  }

  li {
    border-radius: 0.375rem;
    background-color: #202020;
    color: #dfdfdf;

    margin-bottom: 1rem;

    transition-property: background-color color;
    transition: 150ms cubic-bezier(0.4, 0, 0.2, 1);

    &:hover {
      background-color: #262626;
      color: #dddddd;
      box-shadow:
        0 4px 6px -1px rgb(0 0 0 / 0.1),
        0 2px 4px -2px rgb(0 0 0 / 0.1);
    }

    a {
      display: block;
      padding: 0.75rem 0.75rem;
      text-decoration: none;
    }

    h2 {
      margin: 0;
      line-height: 1.3;
      text-wrap: stable;
    }

    span {
      color: #a1a1a1;
    }

    p {
      margin-bottom: 0;
    }

    &:last-of-type {
      margin-bottom: 0;
    }
  }
</style>

<Layout title="Blogposts">
  <p>
    In here I'll kinda just post whatever I feel like :) There might be
    technical stuff, non-technical, whatever I come over in my journeys across
    the internet :3
  </p>
  <p>
    Want to subscribe with RSS? See <a
      href="/blog/feed.rss"
      target="_blank"
      rel="noopener noreferrer"
    >
      /blog/feed.rss
    </a>.
  </p>
  <ul>
    {
      posts.length === 0 ? (
        <p>Nothing here yet... you're early!</p>
      ) : (
        posts.map((post) => (
          <li>
            <a title={post.data.title} href={`/blog/${post.id}`}>
              <h3>{post.data.title}</h3>
              <span>
                Posted: {dateToIso(post.data.pubDate)}
                {post.data.updatedDate &&
                  typeof post.data.updatedDate !== "string" &&
                  post.data.updatedDate > post.data.pubDate &&
                  ` | Updated: ${dateToIso(post.data.updatedDate)}`}
              </span>

              {(post.data.description || post.body) && false && (
                <p>{getDescription(post)}</p>
              )}
            </a>
          </li>
        ))
      )
    }
  </ul>
</Layout>
