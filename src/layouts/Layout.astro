---
import { SITE_NAME, THEME_COLOR, TAGLINE } from "@/constants";
import StyleReset from "@components/StyleReset.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

type Props = {
  title?: string;
  description?: string;
  ogtype?: "article" | "website";
};

const { title, description, ogtype = "website" } = Astro.props;
/** "SITE_NAME" or "title | SITE_NAME" */
const resolvedTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
---

<style lang="scss">
  #skip-to-content {
    left: 50%;
    position: absolute;
    transform: translateY(-110%);
    background: #ebebeb;
    color: #141414;
    height: 30px;
    padding: 8px;
    transition: transform 0.3s;

    &:focus {
      transform: translateY(0%);
    }
  }

  .wrapper {
    padding: 1rem;
    margin-right: auto;
    margin-left: auto;
    height: 100%;

    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;

    @media (width >= 52rem) {
      max-width: 52rem;
    }
  }

  #main {
    margin-top: -1rem;
  }

  header {
    display: flex;
    flex-direction: column;
    align-items: baseline;
    margin-bottom: 1rem;

    @media (width < 52rem) {
      margin-left: auto;
      margin-right: auto;
    }

    @media (width >= 52rem) {
      flex-direction: row;
    }

    & > a {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: baseline;
      margin-right: auto;

      @media (width < 52rem) {
        margin-left: auto;
      }
    }

    img {
      padding-bottom: 0.45rem;
      width: 4rem;
      height: 4rem;
      margin-right: 0.25rem;
      margin-top: auto;
      margin-bottom: auto;
    }

    h1 {
      max-height: 5rem;
      margin-top: auto;
      margin-bottom: auto;
    }

    nav {
      text-align: right;
      margin-top: auto;
      margin-bottom: auto;
    }

    #pronouns {
      padding-left: 0.1rem;
      margin: 0;
    }

    .current-page {
      font-style: italic;
      font-weight: 600;
    }

    a {
      text-decoration: none;
    }
  }
</style>

<!doctype html>
<html lang="en">
  <head prefix="og: https://ogp.me/ns# article: https://ogp.me/ns/article#">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={Astro.url} />

    <title>{resolvedTitle}</title>
    <meta name="title" content={title ?? SITE_NAME} />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="description" content={description ?? TAGLINE} />
    <meta property="og:type" content={ogtype} />

    <slot name="head" />

    <StyleReset />
  </head>
  <body>
    <a href="#main" id="skip-to-content">Skip to content</a>
    <div class="wrapper">

      <Header />

      <main id="main" role="main">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>



<style is:global lang="scss">
  $bgPrimary: #141414;
  $fgPrimary: #ebebeb;

  @font-face {
    font-family: JetBrainsMono;
    src: url(/resources/fonts/jetbrains-mono/jbm-var.woff2) format("woff2");
    font-display: swap;
  }

  @font-face {
    font-family: JetBrainsMono;
    src: url(/resources/fonts/jetbrains-mono/jbm-it-var.woff2) format("woff2");
    font-style: italic;
    font-display: swap;
  }

  * {
    box-sizing: border-box;
    scroll-behavior: smooth;
    @media (width >= 52rem) {
      font-size: 101.5%;
    }
  }

  html,
  body {
    padding: 0;
    margin: 0;
    height: 100%;
    width: 100%;

    background-color: $bgPrimary;
    color: $fgPrimary;
    font-family:
      JetBrainsMono,
      SauceCodePro NFM,
      ui-monospace,
      monospace;

    overflow: auto;
  }

  p {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  h1 {
    margin-top: 0.85rem;
    margin-bottom: 0.85rem;

    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.3;
  }

  h2 {
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;

    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.5;
  }

  h3 {
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;

    font-size: 1.3rem;
    font-weight: 700;
  }

  a {
    color: currentColor;
  }

  details:hover {
    cursor: pointer;
  }
</style>
